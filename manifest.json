{
  "manifest_version": 3,
  "name": "Meet Transcript",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Transcribe Google Meet tab audio with local Whisper, or save live captions.",
  "permissions": ["storage", "activeTab", "tabCapture"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "action": { "default_popup": "popup.html", "default_title": "Meet Transcript" },
  "content_scripts": [{
    "matches": ["https://meet.google.com/*"],
    "js": ["captions.js", "content.js"],
    "run_at": "document_idle"
  }]
}
